<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <keyboard>

    <key n="109">
      <name>m</name>
      <desc>Forward/Reverse</desc>
      <binding>
        <command>nasal</command>
        <script>
          var sens = getprop("controls/engines/engine[0]/mixture");
          if ( sens == 1 ) {
            sens = 0;
          } elsif ( sens == 0 ) {
            sens = 1;
          }
          setprop("controls/engines/engine[0]/mixture", sens);
        </script>
      </binding>
    </key>

