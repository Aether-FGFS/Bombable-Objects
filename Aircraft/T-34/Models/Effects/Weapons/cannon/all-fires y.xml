<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <!-- Jet Blast -->
  <model>
    <name>explosion</name>
    <path>gun.xml</path>
    <condition>
      <property>sim/multiplay/generic/int[10]</property>
    </condition>
    <offsets>
      <x-m> -4.508 </x-m>
      <y-m> -0.750 </y-m>
      <z-m>  0.900 </z-m>
      <pitch-deg> 180 </pitch-deg>
    </offsets>
  </model>

  <animation>
    <type>rotate</type>
    <object-name>explosion</object-name>
    <factor>1</factor>
    <property>sim/multiplay/generic/float[8]</property>
    <property>sim/multiplay/generic/float[9]</property>
      <enable-hot type="bool">false</enable-hot>
      <attach>world</attach>
      <placer>
        <type>point</type>
      </placer>
    <offsets>
      <x-m>0.0</x-m>
      <y-m>0.0</y-m>
      <z-m>1.8</z-m>
      <heading-deg>sim/model/t34/sub-heading</heading-deg>
      <pitch-deg>sim/multiplay/generic/float[9]</pitch-deg>
    </offsets>
    <center>
      <x-m> 0.0 </x-m>
      <y-m> 0.0 </y-m>
      <z-m> 0.0 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 0 </y>
      <z> 1 </z>
    </axis>
  </animation>

  <!-- Smoke -->
  <model>
    <name>smoke</name>
    <path>fire.xml</path>
    <condition>
      <property>sim/multiplay/generic/int[10]</property>
    </condition>
    <offsets>
      <x-m> -4.508 </x-m>
      <y-m> -0.750 </y-m>
      <z-m>  0.900 </z-m>
      <pitch-deg> 180 </pitch-deg>
    </offsets>
  </model>

  <animation>
    <type>rotate</type>
    <object-name>smoke</object-name>
    <factor>1</factor>
    <property>sim/multiplay/generic/float[8]</property>
      <property>sim/multiplay/generic/float[9]</property>
      <enable-hot type="bool">false</enable-hot>
      <attach>world</attach>
      <placer>
        <type>point</type>
      </placer>
    <offsets>
      <x-m>0.0</x-m>
      <y-m>0.0</y-m>
      <z-m>1.8</z-m>
      <heading-deg>sim/model/t34/sub-heading</heading-deg>
      <pitch-deg>sim/multiplay/generic/float[9]</pitch-deg>
    </offsets>
    <center>
      <x-m> 0.0 </x-m>
      <y-m>  0.000 </y-m>
      <z-m> 0.0 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 0 </y>
      <z> 1 </z>
    </axis>
  </animation>

</PropertyList>
