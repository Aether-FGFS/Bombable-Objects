<?xml version="1.0"?>

<PropertyList>

<fx>

  <!-- V-2 Diesel Engine -->
  <engine>
   <name>engine</name>
   <mode>looped</mode>
   <path>Aircraft/T-34/Sounds/t34engine.wav</path>
   <property>/engines/engine/running</property>
   <volume>
    <property>/orientation/alpha-deg</property>
    <type>log</type>
    <min>0.2</min>
    <max>1.0</max>
   </volume>
   <volume>
    <property>/sim/current-view/internal</property>
    <factor>0.4</factor>
   </volume>
   <pitch>
    <property>/engines/engine/mp-osi</property>
    <factor>0.1</factor>
    <min>0.4</min>
    <max>2.0</max>
    <offset>0.9</offset>
   </pitch>
  </engine>

  <!-- Track / drivetrain rumble -->
  <rumble>
   <name>rumble</name>
   <mode>looped</mode>
   <path>Aircraft/T-34/Sounds/t34accel.wav</path>
   <condition>
    <property>gear/gear[0]/wow</property>
    <property>gear/gear[1]/wow</property>
    <property>gear/gear[2]/wow</property>
   </condition>
   <volume>
    <property>velocities/groundspeed-kt</property>
    <type>log</type>
    <factor>0.5</factor>
   </volume>
  </rumble>

  <!-- Turret traverse motor -->
  <turret>
   <name>turret</name>
   <mode>in-transit</mode>
   <path>Aircraft/T-34/Sounds/t34turret.wav</path>
   <condition>
    <property>sim/multiplay/generic/bool[1]</property>
   </condition>
   <volume>
    <factor>0.5</factor>
    <max>1.0</max>
   </volume>
  </turret>

  <!-- Barrel move sound -->
  <barrel>
   <name>barrel</name>
   <mode>in-transit</mode>
   <path>Aircraft/T-34/Sounds/t34barrel.wav</path>
   <condition>
    <property>sim/multiplay/generic/bool[2]</property>
   </condition>
   <volume>
    <factor>0.5</factor>
    <max>1.0</max>
   </volume>
  </barrel>

  <!-- 76mm F-34 Cannon -->
  <cannon>
   <name>cannon</name>
   <mode>once</mode>
   <path>Aircraft/T-34/Sounds/t34cannon.wav</path>
   <condition>
    <property>sim/multiplay/generic/int[10]</property>
   </condition>
   <volume>
    <factor>2.2</factor>
    <max>5.0</max>
   </volume>
   <reference-dist>100</reference-dist>
   <max-dist>1000</max-dist>
  </cannon>

  <!-- Coaxial DT 7.62mm MG -->
  <mg>
   <name>gun</name>
   <mode>looped</mode>
   <path>Aircraft/T-34/Sounds/t34mg.wav</path>
   <condition>
    <property>sim/multiplay/generic/int[11]</property>
   </condition>
   <volume>
    <factor>1.2</factor>
    <max>1.0</max>
   </volume>
   <reference-dist>100</reference-dist>
   <max-dist>1000</max-dist>
  </mg>

  <!-- AA DT 7.62mm MG -->
  <mg-AA>
   <name>AA-gun</name>
   <mode>looped</mode>
   <path>Aircraft/T-34/Sounds/t34mg.wav</path>
   <condition>
    <property>sim/multiplay/generic/int[12]</property>
   </condition>
   <volume>
    <factor>1.2</factor>
    <max>1.0</max>
   </volume>
   <reference-dist>100</reference-dist>
   <max-dist>1000</max-dist>
  </mg-AA>

  <!-- Front hull DT 7.62mm MG (radista) -->
  <mg-front>
   <name>front-gun</name>
   <mode>looped</mode>
   <path>Aircraft/T-34/Sounds/t34mg.wav</path>
   <condition>
    <property>sim/multiplay/generic/int[13]</property>
   </condition>
   <volume>
    <factor>1.0</factor>
    <max>1.0</max>
   </volume>
   <reference-dist>100</reference-dist>
   <max-dist>1000</max-dist>
  </mg-front>

</fx>

</PropertyList>
