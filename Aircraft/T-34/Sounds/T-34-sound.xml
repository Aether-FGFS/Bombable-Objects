<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <fx>
<!-- V-2 Diesel Engine -->
    <engine>
      <name>engine</name>
      <path>t34engine.wav</path>
      <mode>looped</mode>
      <condition>
        <and>
          <property>engines/engine/running</property>
          <property>sim/model/t34/engine-on</property>
        </and>
      </condition>
      <volume>
        <factor>0.7</factor>
      </volume>
      <pitch>
        <property>engines/engine/prop-thrust</property>
        <factor>0.0005</factor>
        <min>0.5</min>
        <max>1.0</max>
        <offset>0.65</offset>
      </pitch>
    </engine>

<!-- Starter motor — bool[4] = starter running synced via MP -->
    <starter>
      <name>mp-starter</name>
      <path>t34starter.wav</path>
      <mode>once</mode>
      <condition>
        <property>sim/multiplay/generic/bool[4]</property>
      </condition>
      <volume>
        <offset>0.7</offset>
        <max>1.0</max>
      </volume>
      <reference-dist>15</reference-dist>
      <max-dist>200</max-dist>
    </starter>

    <!-- Track / drivetrain rumble -->
    <rumble>
      <name>rumble</name>
      <path>t34accel.wav</path>
      <mode>looped</mode>
      <condition>
        <or>
          <property>gear/gear[0]/wow</property>
          <property>gear/gear[1]/wow</property>
          <property>gear/gear[2]/wow</property>
          <property>gear/gear[3]/wow</property>
        </or>
      </condition>
      <volume>
        <property>velocities/groundspeed-kt</property>
        <type>log</type>
        <factor>0.7</factor>
      </volume>
    </rumble>

    <!-- Turret traverse motor -->
    <turret>
      <name>turret</name>
      <path>t34turret.wav</path>
      <mode>in-transit</mode>
      <condition>
        <property>sim/multiplay/generic/bool[1]</property>
      </condition>
      <volume>
        <factor>1.0</factor>
        <max>3.0</max>
      </volume>
    </turret>

    <!-- Barrel move sound -->
    <barrel>
      <name>barrel</name>
      <path>t34barrel.wav</path>
      <mode>in-transit</mode>
      <condition>
        <property>sim/multiplay/generic/bool[2]</property>
      </condition>
      <volume>
        <factor>1.0</factor>
        <max>3.0</max>
      </volume>
    </barrel>

    <!-- 76mm F-34 Cannon -->
    <cannon>
      <name>cannon</name>
      <path>t34cannon.wav</path>
      <mode>once</mode>
      <condition>
        <property>sim/multiplay/generic/int[10]</property>
      </condition>
      <volume>
        <factor>6.9</factor>
        <max>8.0</max>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </cannon>

    <!-- Coaxial DT 7.62mm MG -->
    <mg>
      <name>gun</name>
      <path>t34mg.wav</path>
      <mode>looped</mode>
      <condition>
        <property>sim/multiplay/generic/int[11]</property>
      </condition>
      <volume>
        <factor>1.2</factor>
        <max>1.0</max>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </mg>

    <!-- AA DT 7.62mm MG -->
    <mg-AA>
      <name>AA-gun</name>
      <path>t34mg.wav</path>
      <mode>looped</mode>
      <condition>
        <property>sim/multiplay/generic/int[12]</property>
      </condition>
      <volume>
        <factor>1.2</factor>
        <max>1.0</max>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </mg-AA>

    <!-- Front hull DT 7.62mm MG (radista) -->
    <mg-front>
      <name>front-gun</name>
      <path>t34mg.wav</path>
      <mode>looped</mode>
      <condition>
        <property>sim/multiplay/generic/int[13]</property>
      </condition>
      <volume>
        <factor>1.0</factor>
        <max>1.0</max>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </mg-front>

    <!-- Engine shutdown sound — local player -->
    <engine-stop>
      <name>engine-stop</name>
      <path>t34enginestop.wav</path>
      <mode>once</mode>
      <condition>
        <property>sim/model/t34/engine-stop-sound</property>
      </condition>
      <volume>
        <offset>1.0</offset>
        <max>1.5</max>
      </volume>
    </engine-stop>

    <!-- Brake squeal — kovový škrípot húseníc pri brzdení -->
    <brake-squeal>
      <name>brake-squeal</name>
      <path>t34brakesqueal.wav</path>
      <mode>looped</mode>
      <condition>
        <greater-than>
          <property>sim/multiplay/generic/float[14]</property>
          <value>0.05</value>
        </greater-than>
      </condition>
      <volume>
        <property>sim/multiplay/generic/float[14]</property>
        <factor>1.0</factor>
        <offset>0.0</offset>
        <max>1.2</max>
      </volume>
      <pitch>
        <property>sim/multiplay/generic/float[14]</property>
        <factor>0.5</factor>
        <offset>0.6</offset>
        <max>1.4</max>
      </pitch>
    </brake-squeal>

  </fx>

</PropertyList>
