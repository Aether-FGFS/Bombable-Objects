<?xml version="1.0"?>
<!--
  T-34 Weapon Key Bindings

  
  Controls:
    e         = Fire 76mm F-34 Cannon
    g (hold)  = Coaxial DT MG
    y (hold)  = AA DT MG fire (anti-aircraft)
    u (hold)  = AA MG rotate left
    o (hold)  = AA MG rotate right
    i (hold)  = AA barrel up
    k (hold)  = AA barrel down
    j         = AA center
    q (hold)  = Turret left
    w (hold)  = Turret right
    x         = Turret center
    r (hold)  = Barrel up
    f (hold)  = Barrel down
    c         = Barrel center
-->

<PropertyList>

 <keyboard>

  <!-- ===== CANNON ===== -->
  <key n="101">  <!-- e -->
   <name>e</name>
   <desc>Fire 76mm F-34 Cannon</desc>
   <binding>
    <command>nasal</command>
    <script>t34_weapons.fire_cannon();</script>
   </binding>
  </key>

  <!-- ===== COAXIAL MG ===== -->
  <key n="103">  <!-- g -->
   <name>g</name>
   <desc>Coaxial MG (hold)</desc>
   <binding>
    <command>nasal</command>
    <script>t34_weapons.fire_mg();</script>
   </binding>
   <mod-up>
    <binding>
     <command>nasal</command>
     <script>t34_weapons.stop_mg();</script>
    </binding>
   </mod-up>
  </key>

  <!-- ===== AA MG FIRE ===== -->
  <key n="121">  <!-- y -->
   <name>y</name>
   <desc>AA MG fire (hold)</desc>
   <binding>
    <command>nasal</command>
    <script>t34_weapons.fire_aa();</script>
   </binding>
   <mod-up>
    <binding>
     <command>nasal</command>
     <script>t34_weapons.stop_aa();</script>
    </binding>
   </mod-up>
  </key>

  <!-- ===== AA ROTATE LEFT ===== -->
  <key n="117">  <!-- u -->
   <name>u</name>
   <desc>AA MG rotate left (hold)</desc>
   <binding>
    <command>nasal</command>
    <script>t34_weapons.aa_rotate_start(-1);</script>
   </binding>
   <mod-up>
    <binding>
     <command>nasal</command>
     <script>t34_weapons.aa_rotate_stop();</script>
    </binding>
   </mod-up>
  </key>

  <!-- ===== AA ROTATE RIGHT ===== -->
  <key n="111">  <!-- o -->
   <name>o</name>
   <desc>AA MG rotate right (hold)</desc>
   <binding>
    <command>nasal</command>
    <script>t34_weapons.aa_rotate_start(1);</script>
   </binding>
   <mod-up>
    <binding>
     <command>nasal</command>
     <script>t34_weapons.aa_rotate_stop();</script>
    </binding>
   </mod-up>
  </key>

  <!-- ===== AA BARREL UP ===== -->
  <key n="105">  <!-- i -->
   <name>i</name>
   <desc>AA barrel up (hold)</desc>
   <binding>
    <command>nasal</command>
    <script>t34_weapons.aa_elev_start(1);</script>
   </binding>
   <mod-up>
    <binding>
     <command>nasal</command>
     <script>t34_weapons.aa_elev_stop();</script>
    </binding>
   </mod-up>
  </key>

  <!-- ===== AA BARREL DOWN ===== -->
  <key n="107">  <!-- k -->
   <name>k</name>
   <desc>AA barrel down (hold)</desc>
   <binding>
    <command>nasal</command>
    <script>t34_weapons.aa_elev_start(-1);</script>
   </binding>
   <mod-up>
    <binding>
     <command>nasal</command>
     <script>t34_weapons.aa_elev_stop();</script>
    </binding>
   </mod-up>
  </key>

  <!-- ===== AA CENTER ===== -->
  <key n="106">  <!-- j -->
   <name>j</name>
   <desc>AA center</desc>
   <binding>
    <command>nasal</command>
    <script>t34_weapons.aa_center();</script>
   </binding>
  </key>

  <!-- ===== TURRET LEFT ===== -->
  <key n="113">  <!-- q -->
   <name>q</name>
   <desc>Turret left (hold)</desc>
   <binding>
    <command>nasal</command>
    <script>t34_weapons.turret_start(-1);</script>
   </binding>
   <mod-up>
    <binding>
     <command>nasal</command>
     <script>t34_weapons.turret_stop();</script>
    </binding>
   </mod-up>
  </key>

  <!-- ===== TURRET RIGHT ===== -->
  <key n="119">  <!-- w -->
   <name>w</name>
   <desc>Turret right (hold)</desc>
   <binding>
    <command>nasal</command>
    <script>t34_weapons.turret_start(1);</script>
   </binding>
   <mod-up>
    <binding>
     <command>nasal</command>
     <script>t34_weapons.turret_stop();</script>
    </binding>
   </mod-up>
  </key>

  <!-- ===== TURRET CENTER ===== -->
  <key n="120">  <!-- x -->
   <name>x</name>
   <desc>Turret center</desc>
   <binding>
    <command>nasal</command>
    <script>t34_weapons.turret_center();</script>
   </binding>
  </key>

  <!-- ===== BARREL UP ===== -->
  <key n="114">  <!-- r -->
   <name>r</name>
   <desc>Barrel up (hold)</desc>
   <binding>
    <command>nasal</command>
    <script>t34_weapons.barrel_start(1);</script>
   </binding>
   <mod-up>
    <binding>
     <command>nasal</command>
     <script>t34_weapons.barrel_stop();</script>
    </binding>
   </mod-up>
  </key>

  <!-- ===== BARREL DOWN ===== -->
  <key n="102">  <!-- f -->
   <name>f</name>
   <desc>Barrel down (hold)</desc>
   <binding>
    <command>nasal</command>
    <script>t34_weapons.barrel_start(-1);</script>
   </binding>
   <mod-up>
    <binding>
     <command>nasal</command>
     <script>t34_weapons.barrel_stop();</script>
    </binding>
   </mod-up>
  </key>

  <!-- ===== BARREL CENTER ===== -->
  <key n="99">  <!-- c -->
   <name>c</name>
   <desc>Barrel center</desc>
   <binding>
    <command>nasal</command>
    <script>t34_weapons.barrel_center();</script>
   </binding>
  </key>

  <!-- ===== PREDNÝ MG FIRE ===== -->
      <key n="110">
        <name>n</name>
        <desc>Front MG fire (hold)</desc>
        <binding>
         <command>nasal</command>
          <script>t34_weapons.fire_front_mg();</script>
         </binding>
        <mod-up>
          <binding>
           <command>nasal</command>
           <script>t34_weapons.stop_front_mg();</script>
          </binding>
        </mod-up>
      </key>

      <!-- ===== FRONT MG Left ===== -->
      <key n="276">
        <name>Left</name>
         <desc>Front MG  left (hold)</desc>
        <binding>
         <command>nasal</command>
         <script>t34_weapons.front_mg_h_start(-1);</script>
        </binding>
        <mod-up>
          <binding>
           <command>nasal</command>
           <script>t34_weapons.front_mg_h_stop();</script>
        </binding>
        </mod-up>
      </key>

      <!-- ===== FRONT MG Right ===== -->
      <key n="277">
        <name>Right</name>
          <desc>Front MG right (hold)</desc>
        <binding>
           <command>nasal</command>
           <script>t34_weapons.front_mg_h_start(1);</script>
        </binding>
        <mod-up>
          <binding>
          <command>nasal</command>
          <script>t34_weapons.front_mg_h_stop();</script>
        </binding>
        </mod-up>
      </key>

      <!-- ===== FRONT MG Up ===== -->
      <key n="278">
        <name>Up</name><desc>Front MG Up (hold)</desc>
        <binding>
        <command>nasal</command>
          <script>t34_weapons.front_mg_v_start(1);</script>
          </binding>
        <mod-up>
          <binding>
           <command>nasal</command>
           <script>t34_weapons.front_mg_v_stop();</script>
          </binding>
        </mod-up>
      </key>

      <!-- ===== FRONT MG Down ===== -->
      <key n="279">
        <name>Down</name>
        <desc>Front MG down (hold)</desc>
        <binding>
          <command>nasal</command>
           <script>t34_weapons.front_mg_v_start(-1);</script>
        </binding>
        <mod-up>
          <binding>
           <command>nasal</command>
           <script>t34_weapons.front_mg_v_stop();</script>
          </binding>
        </mod-up>
      </key>

 </keyboard>

 <!-- Nasal module load -->
 <nasal>
  <t34_weapons>
   <file>Aircraft/T-34/Nasal/T-34-weapons.nas</file>
  </t34_weapons>
 </nasal>

 <!-- Multiplay properties for weapon sync -->
 <sim>
  <multiplay>
   <generic>
    <bool n="1" alias="sim/multiplay/generic/bool[1]"/>   <!-- turret sound -->
    <float n="8" alias="sim/multiplay/generic/float[8]"/> <!-- turret heading -->
    <float n="9" alias="sim/multiplay/generic/float[9]"/> <!-- barrel pitch -->
    <float n="10" alias="sim/multiplay/generic/float[10]"/> <!-- AA rotate -->
    <float n="11" alias="sim/multiplay/generic/float[11]"/> <!-- AA elevation -->
    <int n="10" alias="sim/multiplay/generic/int[10]"/>   <!-- cannon -->
    <int n="11" alias="sim/multiplay/generic/int[11]"/>   <!-- coaxial MG -->
    <int n="12" alias="sim/multiplay/generic/int[12]"/>   <!-- AA MG fire -->
   </generic>
  </multiplay>
 </sim>

</PropertyList>