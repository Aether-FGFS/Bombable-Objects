<?xml version="1.0"?>
<PropertyList>
       <sim>
		<description>WWII-La-5</description>
  	        <status>alpha</status>
		<flight-model>yasim</flight-model>
		<aero>WWII-La-5-yasim</aero>
                <author>Emmanuel BARANGER (3D),Aether</author>

		<virtual-cockpit archive="y">true</virtual-cockpit>
		<allow-toggle-cockpit archive="y">true</allow-toggle-cockpit>
		<sound>
   		<path>Aircraft/Generic/generic-sound.xml</path>
		</sound>

		<model>
			<path>Aircraft/WWII-La-5/Models/WWII-La-5.xml</path>
		</model> 


		<ai>
			<submodels>
				<contrails type="bool">false</contrails>
			</submodels>
		</ai>

			<submodels>
    <serviceable type="bool">true</serviceable>
    <path>Aircraft/WWII-La-5/Models/submodels.xml</path>
			</submodels>

    <startup>
     <splash-texture>Aircraft/WWII-La-5/WWII-La-5-splash.png</splash-texture>
    </startup>


		<chase-distance-m type="double" archive="y">-14.0</chase-distance-m>
		<view n="0">
			<internal archive="y">true</internal>   
			<config>
				<x-offset-m archive="y" type="double">-0.5</x-offset-m>  
				<y-offset-m archive="y" type="double">2.1</y-offset-m>
	    	                <z-offset-m archive="y" type="double">0</z-offset-m>				
                                <pitch-offset-deg>-15.0</pitch-offset-deg>
			</config> 	 
		</view>

		<view n="1">
   		<config>
				<target-z-offset-m archive="y" type="double">3.6</target-z-offset-m>   
			</config>
		</view>

		<view n="2">
			<config>
				<target-z-offset-m archive="y" type="double">3.6</target-z-offset-m>
			</config>
		</view>

		<view n="3">
			<config>
		    <target-z-offset-m archive="y" type="double">3.6</target-z-offset-m>
			</config>
		</view>

		<view n="4">
	   <config>
	    <target-z-offset-m archive="y" type="double">3.6</target-z-offset-m>
	   </config>
	  </view>

		<view n="5">
	   <config>
	     <target-z-offset-m archive="y" type="double">3.6</target-z-offset-m>
	   </config>
	  </view>

		<view n="6">
			<config>
				<target-z-offset-m archive="y" type="double">3.6</target-z-offset-m>
			</config>
		</view>

		<hud>   
			<enable3d>false</enable3d>
		</hud>
		

                <multiplay>
                  <generic>
                      <string n="9" type="string"/>
                      <int n="10" alias="controls/armament/trigger" />
                   </generic>
                </multiplay>

	</sim>
	

  

</PropertyList>
