<?xml version="1.0"?>
 
<PropertyList>

<fx>

  <engine>
   <name>engine</name>
   <mode>looped</mode>
   <path>Aircraft/panzer/Sounds/panzerengine.wav</path>
   <property>/engines/engine/running</property>
   <volume>
    <property>/orientation/alpha-deg</property>
    <type>log</type>
    <min>0.2</min>
    <max>1.0</max>
   </volume>
   <volume>
    <property>/sim/current-view/internal</property>
    <factor>0.4</factor>
   </volume>
   <pitch>
    <property>/engines/engine/mp-osi</property>
    <factor>0.1</factor>
    <min>0.4</min>
    <max>2.0</max>
    <offset>0.9</offset>
   </pitch>
  </engine>


  <rumble>
   <name>rumble</name>
   <mode>looped</mode>
   <path>Aircraft/panzer/Sounds/panzeraccel.wav</path>
   <condition>
     <property>gear/gear[0]/wow</property>
     <property>gear/gear[1]/wow</property>
     <property>gear/gear[2]/wow</property>
   </condition>
   <volume>
    <property>velocities/groundspeed-kt</property>
    <type>log</type>
    <factor>0.5</factor>
   </volume>
  </rumble>


  <turret>
   <name>turret</name>
   <mode>in-transit</mode>
   <condition>
    <property>sim/multiplay/generic/bool[1]</property>
   </condition>
   <volume>
   <factor>0.5</factor>
   <max>1.0</max>
   </volume>
   <path>Aircraft/panzer/Sounds/panzerturret.wav</path>
  </turret>

    <cannon>
      <name>cannon</name>
      <mode>once</mode>
      <path>panzerflak88.wav</path>
      <condition>
        <!-- <property>controls/armament/trigger</property> -->
        <property>sim/multiplay/generic/int[10]</property>
      </condition>
      <volume>
        <factor>2.2</factor>
        <max>5.0</max>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </cannon>

    <mg>
      <name>gun</name>
      <mode>looped</mode>
      <path>panzermg34.wav</path>
      <condition>
        <!-- <property>controls/armament/trigger</property> -->
        <property>sim/multiplay/generic/int[11]</property>
      </condition>
      <volume>
        <factor>1.2</factor>
        <max>1.0</max>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </mg>

     <mg-AA>
      <name>AA-gun</name>
      <mode>looped</mode>
      <path>panzermg34.wav</path>
      <condition>
        <!-- <property>controls/armament/trigger</property> -->
        <property>sim/multiplay/generic/int[12]</property>
      </condition>
      <volume>
        <factor>1.2</factor>
        <max>1.0</max>
      </volume>
      <reference-dist>100</reference-dist>
      <max-dist>1000</max-dist>
    </mg-AA>


</fx>
 
</PropertyList>
