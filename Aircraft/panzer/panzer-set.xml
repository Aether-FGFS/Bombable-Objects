<?xml version="1.0"?>


<PropertyList>

 <sim>

  <description>Panzer</description>
  <author>Jack Mermod</author>
  <status>alpha</status>
  <flight-model>yasim</flight-model>
  <aero>panzer-yasim</aero>


  <virtual-cockpit archive="y">true</virtual-cockpit>
  <allow-toggle-cockpit archive="y">true</allow-toggle-cockpit>

  <bombable>
    <player-faction type="string">B</player-faction>
  </bombable>

  <sound>
   <path>Aircraft/panzer/Sounds/panzer-sound.xml</path>
  </sound>

  <model>
   <path>Aircraft/panzer/Models/panzer.xml</path>
   <crew>
     <pilot>
       <visible type="int">1</visible>
     </pilot>
   </crew>
  </model>

    <model>
    <path>lights/all-lights.xml</path>
    </model>



  <submodels>
    <serviceable type="bool">true</serviceable>
    <path>Aircraft/panzer/Models/panzer-submodels.xml</path>
  </submodels>

  <multiplay>
    <generic>
      <string n="9" type="string"/>
      <int    n="10" alias="sim/multiplay/generic/int[10]"/>
      <int    n="11" alias="sim/multiplay/generic/int[11]"/>
      <int    n="12" alias="sim/multiplay/generic/int[12]"/>
      <bool   n="1"  alias="sim/multiplay/generic/bool[1]"/>
      <bool   n="2"  alias="sim/multiplay/generic/bool[2]"/>
      <bool   n="15" alias="/controls/lighting/nav-lights"/>
      <bool   n="16" alias="/controls/lighting/landing-lights"/>
      <float  n="8"  alias="sim/multiplay/generic/float[8]"/>
      <float  n="9"  alias="sim/multiplay/generic/float[9]"/>
      <float  n="10" alias="sim/multiplay/generic/float[10]"/>
      <float  n="11" alias="sim/multiplay/generic/float[11]"/>
    </generic>
  </multiplay> 

  <startup>
     <splash-texture>Aircraft/panzer/splash.png</splash-texture>
  </startup>

  <!-- Aircraft specific help. -->
  <help include="help.xml"/>

		<menubar>
			<default>
				<menu n="10">
					<label>Panzer</label>
					<enabled type="bool">true</enabled>
					<item>
						<label>Find Tow</label>	
						<binding>
							<command>property-toggle</command>
							<property>/controls/aerotow/find-aircraft</property>
						</binding>
					</item>
					<item>
						<label>Dis-/Connect</label>
						<binding>
							<command>property-toggle</command>
							<property>/controls/gear/roof</property>
						</binding>
					</item>
				</menu>
			</default>
		</menubar>

  <view n="0">
   <internal archive="y">true</internal>
   <config>
    <x-offset-m archive="y" type="double">-0.65</x-offset-m> <!-- panzer x-axis from left to right -->
    <y-offset-m archive="y" type="double">2</y-offset-m> <!-- panzer y-axis from up to down -->
    <z-offset-m archive="y" type="double">0</z-offset-m> <!-- panzer z-axis from front to back -->
    <pitch-offset-deg>0.0</pitch-offset-deg>
   </config>
  </view>
  <view n="1">
   <config>
    <target-z-offset-m archive="y" type="double">2.6</target-z-offset-m>
   </config>
  </view>

  <view n="2">
   <config>
    <target-z-offset-m archive="y" type="double">2.6</target-z-offset-m>
   </config>
  </view>

  <view n="3">
   <config>
    <target-z-offset-m archive="y" type="double">2.6</target-z-offset-m>
   </config>
  </view>

  <view n="4">
   <config>
    <target-z-offset-m archive="y" type="double">2.6</target-z-offset-m>
   </config>
  </view>

  <view n="5">
   <config>
    <target-z-offset-m archive="y" type="double">2.6</target-z-offset-m>
   </config>
  </view>

  <view n="6">
   <config>
    <target-z-offset-m archive="y" type="double">2.6</target-z-offset-m>
   </config>
  </view>

  <help>
    <title>Panzer IV Ausf. G - Controls</title>
    <key>
      <name>W / S</name>
      <desc>Drive forward / reverse (throttle)</desc>
    </key>
    <key>
      <name>A / D  or  Left / Right</name>
      <desc>Steer left / right</desc>
    </key>
    <key>
      <name>m / M</name>
      <desc>Engage / disengage reverse gear</desc>
    </key>
    <key>
      <name>q / w</name>
      <desc>Turret rotate left / right (hold = continuous, 2°/step)</desc>
    </key>
    <key>
      <name>x</name>
      <desc>Turret center (face forward)</desc>
    </key>
    <key>
      <name>r / f  (hold)</name>
      <desc>Barrel elevation up / down (continuous, limits -8° / +20°)</desc>
    </key>
    <key>
      <name>c</name>
      <desc>Barrel center (0° elevation)</desc>
    </key>
    <key>
      <name>e</name>
      <desc>Fire 75mm KwK 40 cannon (single shot, ~800 m/s)</desc>
    </key>
    <key>
      <name>g  (hold)</name>
      <desc>Fire MG 34 machine gun (7.92mm, ~755 m/s)</desc>
    </key>
    <line>Joystick: map turret axis to float[8], barrel axis to float[9]</line>
    <line>Cannon trigger: sim/multiplay/generic/int[10]</line>
    <line>MG trigger:     sim/multiplay/generic/int[11]</line>
    <line>AA MG trigger:  sim/multiplay/generic/int[12]</line>
    <key>
      <n>u / o  (hold)</n>
      <desc>AA MG rotate left / right</desc>
    </key>
    <key>
      <n>i / k  (hold)</n>
      <desc>AA MG elevation up / down (limits -10° / +85°)</desc>
    </key>
    <key>
      <n>j</n>
      <desc>AA MG center (heading + elevation reset)</desc>
    </key>
    <key>
      <n>p  (hold)</n>
      <desc>Fire AA MG 34 Fliegerabwehr (anti-aircraft)</desc>
    </key>
    <key>
      <name>Shift+L</name>
      <desc>Headlights ON / OFF</desc>
    </key>
  </help>

 </sim>

 <engines>
  <engine>
   <rpm type="double">2800</rpm>
  </engine>
 </engines>
 <controls>
   <engines>
      <engine n="0">
        <magnetos>3</magnetos>
      </engine>
   </engines>
	<gear>
		<screen type="bool">false</screen>
		<roof type="bool">false</roof>
	</gear>
	<panzer>
		<turret-deg type="double">0</turret-deg>
	</panzer>
 </controls>
<input>
	<keyboard>

        <key n="77"> 
          <name>M</name>
          <desc>engage Reverse</desc>
          <binding> 
            <command>property-assign</command>
            <property>controls/engines/engine[0]/mixture</property>
            <value type="double">0.0</value>
          </binding>
        </key>

        <key n="109"> 
          <name>m</name>
          <desc>disengage Reverse</desc>
          <binding> 
            <command>property-assign</command>
            <property>controls/engines/engine[0]/mixture</property>
            <value type="double">1.0</value>
          </binding>
        </key>


        <!-- Kanón: e -->
        <key n="101">
          <n>e</n>
          <desc>Fire cannon (30s reload)</desc>
          <binding>
            <command>nasal</command>
            <script>panzer_weapons.fire_cannon();</script>
          </binding>
        </key>

        <!-- Guľomet: g (drž) -->
        <key n="103">
          <n>g</n>
          <desc>Fire machine gun</desc>
          <binding>
            <command>property-assign</command>
            <property>sim/multiplay/generic/int[11]</property>
            <value type="int">1</value>
          </binding>
          <mod-up>
            <binding>
              <command>property-assign</command>
              <property>sim/multiplay/generic/int[11]</property>
              <value type="int">0</value>
            </binding>
          </mod-up>
        </key>

        <!-- Veža doľava: q -->
        <key n="113">
          <n>q</n>
          <desc>Turret left (hold)</desc>
          <binding>
            <command>nasal</command>
            <script>panzer_weapons.turret_start(-1);</script>
          </binding>
          <mod-up>
            <binding>
              <command>nasal</command>
              <script>panzer_weapons.turret_stop();</script>
            </binding>
          </mod-up>
        </key>

        <!-- Veža doprava: w (hold) -->
        <key n="119">
          <n>w</n>
          <desc>Turret right (hold)</desc>
          <binding>
            <command>nasal</command>
            <script>panzer_weapons.turret_start(1);</script>
          </binding>
          <mod-up>
            <binding>
              <command>nasal</command>
              <script>panzer_weapons.turret_stop();</script>
            </binding>
          </mod-up>
        </key>

        <!-- Veža na stred: x -->
        <key n="120">
          <n>x</n>
          <desc>Turret center</desc>
          <binding>
            <command>property-assign</command>
            <property>sim/multiplay/generic/float[8]</property>
            <value type="double">0</value>
          </binding>
        </key>

        <!-- Barrel up: r (hold) -->
        <key n="114">
          <n>r</n>
          <desc>Barrel up (hold)</desc>
          <binding>
            <command>nasal</command>
            <script>panzer_weapons.barrel_start(0.5);</script>
          </binding>
          <mod-up>
            <binding>
              <command>nasal</command>
              <script>panzer_weapons.barrel_stop();</script>
            </binding>
          </mod-up>
        </key>

        <!-- Barrel down: f (hold) -->
        <key n="102">
          <n>f</n>
          <desc>Barrel down (hold)</desc>
          <binding>
            <command>nasal</command>
            <script>panzer_weapons.barrel_start(-0.5);</script>
          </binding>
          <mod-up>
            <binding>
              <command>nasal</command>
              <script>panzer_weapons.barrel_stop();</script>
            </binding>
          </mod-up>
        </key>

        <!-- Barrel center: c -->
        <key n="99">
          <n>c</n>
          <desc>Barrel center</desc>
          <binding>
            <command>property-assign</command>
            <property>sim/multiplay/generic/float[9]</property>
            <value type="double">0</value>
          </binding>
        </key>

        <!-- AA MG rotate left: u (hold) -->
        <key n="117">
          <n>u</n>
          <desc>AA MG rotate left (hold)</desc>
          <binding>
            <command>nasal</command>
            <script>panzer_weapons.aa_rotate_start(-2);</script>
          </binding>
          <mod-up>
            <binding>
              <command>nasal</command>
              <script>panzer_weapons.aa_rotate_stop();</script>
            </binding>
          </mod-up>
        </key>

        <!-- AA MG rotate right: o (hold) -->
        <key n="111">
          <n>o</n>
          <desc>AA MG rotate right (hold)</desc>
          <binding>
            <command>nasal</command>
            <script>panzer_weapons.aa_rotate_start(2);</script>
          </binding>
          <mod-up>
            <binding>
              <command>nasal</command>
              <script>panzer_weapons.aa_rotate_stop();</script>
            </binding>
          </mod-up>
        </key>

        <!-- AA MG up: i (hold) -->
        <key n="105">
          <n>i</n>
          <desc>AA MG barrel up (hold)</desc>
          <binding>
            <command>nasal</command>
            <script>panzer_weapons.aa_elev_start(1);</script>
          </binding>
          <mod-up>
            <binding>
              <command>nasal</command>
              <script>panzer_weapons.aa_elev_stop();</script>
            </binding>
          </mod-up>
        </key>

        <!-- AA MG down: k (hold) -->
        <key n="107">
          <n>k</n>
          <desc>AA MG barrel down (hold)</desc>
          <binding>
            <command>nasal</command>
            <script>panzer_weapons.aa_elev_start(-1);</script>
          </binding>
          <mod-up>
            <binding>
              <command>nasal</command>
              <script>panzer_weapons.aa_elev_stop();</script>
            </binding>
          </mod-up>
        </key>

        <!-- AA MG center: j -->
        <key n="106">
          <n>j</n>
          <desc>AA MG center (heading + elevation reset)</desc>
          <binding>
            <command>property-assign</command>
            <property>sim/multiplay/generic/float[10]</property>
            <value type="double">0</value>
          </binding>
          <binding>
            <command>property-assign</command>
            <property>sim/multiplay/generic/float[11]</property>
            <value type="double">0</value>
          </binding>
        </key>

        <!-- AA MG fire: y (hold) -->
        <key n="121">
          <n>y</n>
          <desc>AA MG fire (hold)</desc>
          <binding>
            <command>property-assign</command>
            <property>sim/multiplay/generic/int[12]</property>
            <value type="int">1</value>
          </binding>
          <mod-up>
            <binding>
              <command>property-assign</command>
              <property>sim/multiplay/generic/int[12]</property>
              <value type="int">0</value>
            </binding>
          </mod-up>
        </key>

        <!-- Lights: Shift+T (toggle) -->
        <key n="84">
          <name>T</name>
      <desc>Navigation light ON/OFF</desc>
      <binding>
        <command>property-toggle</command>
        <!-- <property>controls/lighting/nav-lights</property> -->
        <property>sim/multiplay/generic/bool[15]</property>
      </binding>
    </key>

        <!-- Lights: Shift+L (toggle) -->
        <key n="76">
          <name>L</name>
      <desc>Landing light ON/OFF</desc>
      <binding>
        <command>property-toggle</command>
        <!-- <property>controls/lighting/landing-lights</property> -->
        <property>sim/multiplay/generic/bool[16]</property>
      </binding>
    </key>

	</keyboard>
</input>

<nasal>
<tracks>
<file>Aircraft/panzer/tank-tracks.nas</file>
</tracks>
<panzer_weapons>
<file>Aircraft/panzer/panzer-weapons.nas</file>
</panzer_weapons>
</nasal>

</PropertyList>




