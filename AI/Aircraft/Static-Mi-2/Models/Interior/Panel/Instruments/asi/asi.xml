<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>asi.ac</path>

  <animation>
    <object-name>fond</object-name>
    <object-name>face</object-name>
    <object-name>needle</object-name>
    <object-name>vitre</object-name>
  </animation>

  <animation>
    <type>noshadow</type>
    <object-name>fond</object-name>
    <object-name>face</object-name>
    <object-name>needle</object-name>
    <object-name>vitre</object-name>
  </animation>

  <!-- working for Compositor -->
  <effect>
    <inherits-from>../../../../Effects/Glass/glass</inherits-from>
    <object-name>vitre</object-name>
  </effect>

  <animation>
    <type>material</type>
    <object-name>face</object-name>
    <object-name>needle</object-name>
    <condition>
      <property>controls/electric/battery-switch</property>
    </condition>
    <emission>
      <factor-prop>controls/lighting/instruments-norm</factor-prop>
      <red>   0.50 </red>
      <green> 0.40 </green>
      <blue>  0.30 </blue>
    </emission>
  </animation>

  <!-- Airspeed Needle
    km/h to kts
      20 =  10.79
      40 =  21.59
      60 =  32.39
      80 =  43.19
     100 =  53.99
     150 =  80.99
     200 = 107.99
     250 = 134.98
  -->
  <animation>
    <type>rotate</type>
    <object-name>needle</object-name>
    <property>velocities/airspeed-kt</property>
    <interpolation>
      <entry><ind>   0.00 </ind><dep>   0 </dep></entry>
      <entry><ind>  10.79 </ind><dep>  14 </dep></entry>
      <entry><ind>  21.59 </ind><dep>  39 </dep></entry>
      <entry><ind>  32.39 </ind><dep>  64 </dep></entry>
      <entry><ind>  43.19 </ind><dep>  90 </dep></entry>
      <entry><ind>  53.99 </ind><dep> 116 </dep></entry>
      <entry><ind>  80.99 </ind><dep> 191 </dep></entry>
      <entry><ind> 107.99 </ind><dep> 267 </dep></entry>
      <entry><ind> 134.98 </ind><dep> 342 </dep></entry>
    </interpolation>
    <axis>
      <x> -1 </x>
      <y>  0 </y>
      <z>  0 </z>
    </axis>
  </animation>

</PropertyList>
