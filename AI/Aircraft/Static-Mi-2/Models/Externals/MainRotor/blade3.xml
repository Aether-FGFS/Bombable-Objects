<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <!-- Chaque pales est formée de 4 parties

       Axe 0               Axe 1               Axe 2               Axe 3
         +______blade1_______+_______blade2______+______blade3_______+_____blade4________
      center
        of
       rotor

  -->
  <path>blade.ac</path>

  <animation>
    <object-name>baseblade</object-name>
    <object-name>baseaxe</object-name>
    <object-name>axe</object-name>
    <object-name>entretoise</object-name>
    <object-name>blade1</object-name>
    <object-name>blade2</object-name>
    <object-name>blade3</object-name>
    <object-name>blade4</object-name>

    <!-- Transparence -->
    <object-name>propblur1</object-name>
    <object-name>propblur2</object-name>
    <object-name>propblur3</object-name>
    <object-name>propblur4</object-name>
    <object-name>propdisc1</object-name>
    <object-name>propdisc2</object-name>
    <object-name>propdisc3</object-name>
    <object-name>propdisc4</object-name>
  </animation>

  <effect>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>propblur1</object-name>
    <object-name>propblur2</object-name>
    <object-name>propblur3</object-name>
    <object-name>propblur4</object-name>
    <object-name>propdisc1</object-name>
    <object-name>propdisc2</object-name>
    <object-name>propdisc3</object-name>
    <object-name>propdisc4</object-name>
  </effect>

  <animation>
    <type>noshadow</type>
    <object-name>propblur1</object-name>
    <object-name>propblur2</object-name>
    <object-name>propblur3</object-name>
    <object-name>propblur4</object-name>
    <object-name>propdisc1</object-name>
    <object-name>propdisc2</object-name>
    <object-name>propdisc3</object-name>
    <object-name>propdisc4</object-name>
  </animation>

  <!-- Sélection blade/blur/disc main rotor-->
  <animation>
    <name>DiscComplet</name>
    <object-name>propdisc1</object-name>
    <object-name>propdisc2</object-name>
    <object-name>propdisc3</object-name>
    <object-name>propdisc4</object-name>
  </animation>

  <animation>
    <type>select</type>
    <object-name>DiscComplet</object-name>
    <condition>
      <greater-than>
        <!-- <property>rotors/main/rpm</property> -->
        <property>sim/multiplay/generic/float[9]</property>
        <value>150</value>
      </greater-than>
    </condition>
  </animation>

  <animation>
    <name>BlurComplet</name>
    <object-name>propblur1</object-name>
    <object-name>propblur2</object-name>
    <object-name>propblur3</object-name>
    <object-name>propblur4</object-name>
  </animation>

  <animation>
    <type>select</type>
    <object-name>BlurComplet</object-name>
    <condition>
      <and>
        <greater-than>
          <!-- <property>rotors/main/rpm</property> -->
          <property>sim/multiplay/generic/float[9]</property>
          <value>60</value>
        </greater-than>
        <less-than>
          <!-- <property>rotors/main/rpm</property> -->
          <property>sim/multiplay/generic/float[9]</property>
          <value>150.001</value>
        </less-than>
      </and>
    </condition>
  </animation>

  <animation>
    <type>translate</type>
    <object-name>entretoise</object-name>
    <!-- <property>rotors/main/blade[2]/incidence-deg</property> -->
    <property>sim/multiplay/generic/float[23]</property>
    <factor>0.005</factor>
    <axis>
      <x> 0 </x>
      <y> 0 </y>
      <z> 1 </z>
    </axis>
  </animation>

  <!-- Axe 0 de pliage des pâles pour le cône -->
  <animation>
    <name>Total0</name>
    <object-name>blade4</object-name>
    <object-name>propblur4</object-name>
    <object-name>propdisc4</object-name>
    <object-name>blade3</object-name>
    <object-name>propblur3</object-name>
    <object-name>propdisc3</object-name>
    <object-name>blade2</object-name>
    <object-name>propblur2</object-name>
    <object-name>propdisc2</object-name>
    <object-name>blade1</object-name>
    <object-name>propblur1</object-name>
    <object-name>propdisc1</object-name>
    <object-name>baseaxe</object-name>
    <object-name>baseblade</object-name>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>Total0</object-name>
    <!-- <property>rotors/main/cone1-deg</property> -->
    <property>sim/multiplay/generic/float[17]</property>
    <factor> 1 </factor>
    <center>
      <x-m> -0.19616 </x-m>
      <y-m>  0.02754 </y-m>
      <z-m>  0.48390 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!-- Axe 1 de pliage des pâles pour le cône -->
  <animation>
    <name>Total1</name>
    <object-name>blade4</object-name>
    <object-name>propblur4</object-name>
    <object-name>propdisc4</object-name>
    <object-name>blade3</object-name>
    <object-name>propblur3</object-name>
    <object-name>propdisc3</object-name>
    <object-name>blade2</object-name>
    <object-name>propblur2</object-name>
    <object-name>propdisc2</object-name>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>Total1</object-name>
    <!-- <property>rotors/main/cone2-deg</property> -->
    <property>sim/multiplay/generic/float[18]</property>
    <factor> 1 </factor>
    <center>
      <x-m> -2.81774 </x-m>
      <y-m> -0.10381 </y-m>
      <z-m>  0.47188 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!-- Axe 2 de pliage des pâles pour le cône -->
  <animation>
    <name>Total2</name>
    <object-name>blade4</object-name>
    <object-name>propblur4</object-name>
    <object-name>propdisc4</object-name>
    <object-name>blade3</object-name>
    <object-name>propblur3</object-name>
    <object-name>propdisc3</object-name>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>Total2</object-name>
    <!-- <property>rotors/main/cone3-deg</property> -->
    <property>sim/multiplay/generic/float[19]</property>
    <factor> 1 </factor>
    <center>
      <x-m> -4.33371 </x-m>
      <y-m> -0.10381 </y-m>
      <z-m> -0.47188 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!-- Axe 3 de pliage des pâles pour le cône -->
  <animation>
    <name>Total3</name>
    <object-name>blade4</object-name>
    <object-name>propblur4</object-name>
    <object-name>propdisc4</object-name>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>Total3</object-name>
    <!-- <property>rotors/main/cone4-deg</property> -->
    <property>sim/multiplay/generic/float[20]</property>
    <factor> 1 </factor>
    <center>
      <x-m> -5.85281 </x-m>
      <y-m> -0.10381 </y-m>
      <z-m> -0.47188 </z-m>
    </center>
    <axis>
      <x> 0 </x>
      <y> 1 </y>
      <z> 0 </z>
    </axis>
  </animation>

  <!-- Incidence de la pale -->
  <animation>
    <name>TotalBlade</name>
    <object-name>blade1</object-name>
    <object-name>blade2</object-name>
    <object-name>blade3</object-name>
    <object-name>blade4</object-name>
    <object-name>baseblade</object-name>
  </animation>

  <animation>
    <type>rotate</type>
    <object-name>TotalBlade</object-name>
    <!-- <property>rotors/main/blade[2]/incidence-deg</property> -->
    <property>sim/multiplay/generic/float[23]</property>
    <factor>1</factor>
    <center>
      <x-m> -0.80288 </x-m>
      <y-m>  0.02889 </y-m>
      <z-m>  0.48390 </z-m>
    </center>
    <axis>
      <x> 1 </x>
      <y> 0 </y>
      <z> 0 </z>
    </axis>
  </animation>

</PropertyList>
