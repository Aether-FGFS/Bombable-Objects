<?xml version="1.0" encoding="ISO-8859-1"?>

<PropertyList>

  <path>mainrotor.ac</path>

  <animation>
    <object-name>axe0</object-name>
    <object-name>axe1</object-name>
  </animation>

  <!-- Blades -->
  <model>
    <name>Blade1</name>
    <path>blade1.xml</path>
  </model>

  <model>
    <name>Blade2</name>
    <path>blade2.xml</path>
    <offsets>
      <heading-deg> 120 </heading-deg>
    </offsets>
  </model>

  <model>
    <name>Blade3</name>
    <path>blade3.xml</path>
    <offsets>
      <heading-deg> 240 </heading-deg>
    </offsets>
  </model>

  <animation>
    <type>translate</type>
    <object-name>axe1</object-name>
    <!-- <property>rotors/main/blade[0]/incidence-deg</property> -->
    <property>sim/multiplay/generic/float[21]</property>
    <factor>0.005</factor>
    <axis>
      <x> 0 </x>
      <y> 0 </y>
      <z> 1 </z>
    </axis>
  </animation>

  <animation>
    <name>rotorcomplet</name>
    <object-name>axe0</object-name>
    <object-name>axe1</object-name>
    <object-name>Blade1</object-name>
    <object-name>Blade2</object-name>
    <object-name>Blade3</object-name>
  </animation>

  <!-- Rotation du rotor -->
  <animation>
    <type>rotate</type>
    <object-name>rotorcomplet</object-name>
    <!-- <property>/rotors/main/blade[0]/position-deg</property> -->
    <property>sim/multiplay/generic/float[26]</property>
    <factor> -10 </factor>
    <axis>
      <x>  0 </x>
      <y>  0 </y>
      <z>  1 </z>
    </axis>
  </animation>

</PropertyList>
